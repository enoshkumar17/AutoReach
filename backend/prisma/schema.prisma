generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String
  name          String
  role          String             @default("USER") // USER, ADMIN
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  profile       CandidateProfile?
  projects      Project[]
  applications  Application[]
  notifications Notification[]
}

model CandidateProfile {
  id                  Int      @id @default(autoincrement())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  phone               String?
  college             String?
  degree              String?
  targetBatch         Int?     @default(2028)
  targetRoles         String?  @default("SWE, SDE, Backend, Fullstack, Systems")
  emailAlertsEnabled  Boolean  @default(true)
  alertFrequency      String   @default("INSTANT")
  linkedin            String?
  github              String?
  portfolio           String?
  resumePath          String?
  gmailUser           String?
  gmailAppPassword    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  tags        String   // Comma-separated, e.g. "React, TypeScript, Node.js"
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime @default(now())
}

model Notification {
  id              Int       @id @default(autoincrement())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    @default("JOB_ALERT") // JOB_ALERT, CLOSING_SOON, HACKATHON, SYSTEM
  title           String
  message         String
  company         String?
  role            String?
  url             String?
  batch           Int?
  matchScore      Int       @default(90)
  isRead          Boolean   @default(false)
  emailSent       Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model Application {
  id              Int       @id @default(autoincrement())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  recipientName   String?
  recipientEmail  String
  role            String
  jobType         String    @default("Internship")
  status          String    @default("SENT") // DRAFT, SENT, FOLLOW_UP_DUE, REPLIED, REJECTED, INTERVIEW
  emailSubject    String
  emailBody       String
  sourceType      String    @default("TEXT") // SCREENSHOT, TEXT
  matchedProjects String?
  notes           String?
  messageId       String?
  followUpCount   Int       @default(0)
  lastFollowUpAt  DateTime?
  sentiment       String?   // INTERVIEW, QUESTION, REJECTED, GENERAL
  replySnippet    String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
